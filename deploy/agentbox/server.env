# Environnement du conteneur rimlike-server (hébergement de test agentbox).
# Aucun secret ici : ce fichier est versionné. Variables documentées dans
# apps/server/src/index.ts et apps/server/README.md.
#
# Changer WORLD_SEED / WORLD_SUBDIVISIONS / WORLD_DAY_SCALE sur un monde
# peuplé = repartir de zéro (voir deploy/README.md, « Changer le globe ») :
# faire `rimlike-ctl reset` dans la foulée.

WORLD_SEED=1
# 4 = 2 562 cases : suffisant pour un test à quelques joueurs, /world léger.
WORLD_SUBDIVISIONS=4
WORLD_DAY_SCALE=30
WORLD_STATE_FILE=/data/world-state.json
# Le pod n'est joignable que par Caddy, qui remplace X-Forwarded-For par
# CF-Connecting-IP (voir Caddyfile) : on peut donc s'y fier pour le compteur
# de connexions par IP — sans ça, tous les joueurs partageraient 127.0.0.1.
TRUST_PROXY=1
HOST=127.0.0.1
PORT=8787

{
  "name": "rimlike",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build:wasm": "wasm-pack build crates/sim-wasm --release --target web --out-dir ../../apps/client/src/wasm --out-name sim",
    "dev": "pnpm build:wasm && pnpm --filter client dev",
    "build": "pnpm build:wasm && pnpm --filter client build",
    "test": "cargo test --workspace",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings && pnpm --filter client typecheck",
    "fmt": "cargo fmt --all"
  }
}
